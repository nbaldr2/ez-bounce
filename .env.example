# Copy to .env and edit. `docker compose` reads this file automatically.

# ---------------------------------------------------------------------------
# REQUIRED — the SMTP identity Reacher presents to receiving mail servers.
# ---------------------------------------------------------------------------
# Must match the PTR / reverse-DNS record of this VPS's outbound IP.
# Verify with:  dig -x <your.vps.ip> +short
REACHER_HELLO_NAME=mail.yourdomain.com
# A real, deliverable address on a domain you control. Receiving servers do
# check it, and some will reject a MAIL FROM whose domain has no valid MX/SPF.
REACHER_FROM_EMAIL=verify@yourdomain.com

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Pin the Reacher image once you have a working version.
# REACHER_IMAGE=reacherhq/backend:latest
# Shared secret between the app and Reacher. Leave blank unless you need it.
# REACHER_HEADER_SECRET=
REACHER_LOG=info
REACHER_TIMEOUT_MS=45000

# Where the UI is published on the host. Keep 127.0.0.1 and reverse-proxy it:
# the app has no authentication of its own.
BIND_ADDR=127.0.0.1
HOST_PORT=3000

# ---------------------------------------------------------------------------
# Rate limiting — the settings you will actually tune
# ---------------------------------------------------------------------------
# Per pool: concurrency = parallel SMTP checks, delay = minimum ms between
# request *starts* across the whole pool. Effective ceiling per pool is
#   min(concurrency / smtp_latency, 1000 / delay)  addresses per second.
#
# Gmail is deliberately the slowest. Google throttles per source IP and answers
# 421/450 when pushed; those are retried, never counted as invalid, but they
# waste hours. Start here and only raise it if you see zero temp-fails.
GMAIL_CONCURRENCY=2
GMAIL_DELAY_MS=1500

MICROSOFT_CONCURRENCY=3
MICROSOFT_DELAY_MS=1000
YAHOO_CONCURRENCY=2
YAHOO_DELAY_MS=1200
APPLE_CONCURRENCY=2
APPLE_DELAY_MS=1200
PROTON_CONCURRENCY=3
PROTON_DELAY_MS=500
OTHER_CONCURRENCY=8
OTHER_DELAY_MS=100

# Backoff for 4xx temp-fails, in ms, applied in order. After the last one the
# address is recorded as "unknown".
RETRY_BACKOFF_MS=30000,120000,600000

# ---------------------------------------------------------------------------
# Prefilter
# ---------------------------------------------------------------------------
# Extra domains to drop before SMTP, comma separated (matches subdomains too).
BLOCKED_DOMAINS=
# Newline-delimited file of disposable domains to merge with the built-in list.
# DISPOSABLE_DOMAINS_FILE=/etc/ezd/disposable.txt
MAX_UPLOAD_MB=250
MX_CACHE_TTL_SECONDS=86400
